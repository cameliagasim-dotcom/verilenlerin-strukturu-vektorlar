#include <vector>
#include <algorithm>
using namespace std;
int main() {
    cout<<"sayi daxil edin";
    int n;
    cin>>n;
    vector<int>A(n);
    int max=0;
    for(int i=0;i<n;i++){
        cin>>A[i];
        if (A[i]>A[max]) 
          max=1;
